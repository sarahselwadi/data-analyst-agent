# Azure AI Foundry Configuration
# Replace with your actual Azure AI Project endpoint
AIPROJECT_ENDPOINT=https://your-project.eastus.azureai.azure.com

# Replace with your actual model deployment name
CHAT_MODEL=gpt-4.1

# Optional: Pre-created Agent ID (recommended for production)
# Create an agent in "Azure AI Foundry Studio and use its ID here
# If not provided, an agent will be created dynamically
AGENT_ID=your-agent-id

# Optional: Azure subscription ID (if needed)
AZURE_SUBSCRIPTION_ID=your-subscription-id

# Optional: Azure resource group (if needed)
AZURE_RESOURCE_GROUP=your-resource-group

# ── Blob Storage (single account, connection-string auth) ──────────────
# Connection string for the storage account used for both input and output
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net

# Container where client attachments are stored (read-only)
O_CONTAINER_NAME=client-attachments

# Container for AI-generated output artifacts (auto-created on first use)
OUTPUT_CONTAINER_NAME=data-analyst-output-files

# ── Cosmos DB Configuration ────────────────────────────────────────────
# Cosmos DB endpoint (API key auth)
COSMOS_DB_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/

# Cosmos DB account key (provides data + control plane access for container auto-creation)
COSMOS_API_KEY=your-cosmos-account-key

# Cosmos DB database name
COSMOS_DB_NAME=data_analyst_db

# Container for session-to-thread mappings
COSMOS_CONTAINER_NAME=threadssessions

# Container for artifact retention tracking (partition key: /date)
# Used by this app to log files/threads; used by deletion job to query & clean up
COSMOS_CONTAINER_NAME_ARTIFACT_REGISTRY=artifact_registry

# Container for code interpreter execution logs (partition key: /session_id)
# Stores input code, stdout/stderr logs, and image file_ids from each Code Interpreter invocation
COSMOS_CONTAINER_NAME_CODE=code_executions

# Note: Authentication is handled by DefaultAzureCredential for AI Foundry.
# Cosmos DB uses the API key above (account-key auth).
# Blob storage uses the connection string above (account-key auth).
